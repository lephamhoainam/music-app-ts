extends ../../layouts/auth.pug

block main
    .auth-page.d-flex.align-items-center.justify-content-center(style="min-height: 100vh; background: #f5f6fa;")
        .card.shadow-sm(style="width: 420px; border: none; border-radius: 12px;")
            .card-body.p-4
                .text-center.mb-4
                    h2.font-weight-bold Đăng nhập Admin
                    p.text-muted.mb-0 Vui lòng nhập thông tin đăng nhập

                form(action=`/${prefixAdmin}/auth/login` method="POST")
                    .form-group.mb-3
                        label(for="email") Email
                        input#email.form-control(
                            type="email"
                            name="email"
                            placeholder="Nhập email..."
                            required
                        )

                    .form-group.mb-4
                        label(for="password") Mật khẩu
                        input#password.form-control(
                            type="password"
                            name="password"
                            placeholder="Nhập mật khẩu..."
                            required
                        )

                    button.btn.btn-primary.btn-block(type="submit")
                        | Đăng nhập

                .text-center.mt-3
                    p
                        | Quên mật khẩu (Liên hệ với admin để lấy lại)