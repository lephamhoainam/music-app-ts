extends ../../layouts/default.pug

block main 
    h1.mb-4 #{pageTitle}

    .card.mb-3 
        .card-header Danh sách bài hát
        .card-body
            .row.mb-3.align-items-center
                .col-8 

                .col-4.text-right 
                    a.btn.btn-outline-success.shadow-sm(href=`/${prefixAdmin}/songs/create`) 
                        | + Thêm mới
            
            table.table.table-hover
                thead 
                    tr 
                        th STT 
                        th Hình ảnh 
                        th Tiêu đề 
                        th Ca sĩ 
                        th Chủ đề
                        th Trạng thái 
                        th Hành động 
                tbody 
                    if(songs.length > 0)
                        each item, index in songs 
                            tr 
                                td #{index+1} 
                                td 
                                    img(src=item.avatar, alt=item.title width="100px" height="auto")
                                td #{item.title} 
                                th #{item.infoSinger.fullname} 
                                th #{item.infoTopic.title}
                                td
                                    if(item.status === "active")
                                        a.status-badge.active(href="javascript:;") Hoạt động 
                                    else 
                                        a.status-badge.inactive(href="javascript:;") Dừng hoạt động 
                                td 
                                    a.btn.btn-secondary.btn-sm.mr-1(href=`/${prefixAdmin}/songs/detail/${item.id}`) 
                                        <i class="fa-regular fa-eye"></i>  
                                    a.btn.btn-warning.btn-sm.mr-1(href=`/${prefixAdmin}/songs/edit/${item.id}`)
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    button.btn.btn-danger.btn-sm(type="button" button-delete data-id=item.id) 
                                        <i class="fa-solid fa-trash"></i>
                    else 
                        tr 
                            td Không có dữ liệu

        //- form(action="", method="POST" id="form-change-status" data-path=`${prefixAdmin}/products/change-status`) 
        form(action="", method="POST" id="form-delete-item" data-path=`/${prefixAdmin}/songs/delete`)
