extends ../../layouts/default.pug

block main 
    .content-wrapper
        form.song-form(action=`/${prefixAdmin}/songs/create?_method=PATCH` method="POST" enctype="multipart/form-data")
            .page-header.d-flex.justify-content-between.align-items-start.mb-4
                .header-left
                    h1.mb-2 #{pageTitle}

                .header-actions
                    button.btn.btn-outline-secondary.mr-2(type="button" onclick="window.location.href='/admin/songs'")
                        | Hủy
                    button.btn.btn-primary(type="submit")
                        | Cập nhật bài hát

            .row
                .col-md-6
                    .form-group
                        label(for="title")
                            | Tên bài hát
                        input#title.form-control(type="text" name="title" value=song.title required)

                .col-md-6
                    .form-group
                        label(for="singer")
                            | Ca sĩ
                        select#singer.form-control(name="singerId" required)
                            each item in singers
                                option(value=item.id selected=item.id == song.singerId) #{item.fullname}

            .row 
                .col-md-8
                    .form-group
                        label(for="topic")
                            | Chủ đề 
                        select#topic.form-control(name="topicId" required)
                            each item in topics
                                option(value=item.id selected=item.id == song.topicId) #{item.title}
                .col-md-4
                    .form-group
                        label(for="status")
                            | Trạng thái
                        select#status.form-control(name="status")
                            option(value="active" selected=song.status === "active")
                                | Hoạt động (Mặc định)
                            option(value="inactive" selected=song.status === "inactive")
                                | Dừng hoạt động 

            .form-group
                label(for="description")
                    | Mô tả
                textarea#description.form-control.textarea-tinymce(name="description" rows="4") #{song.description}
            
            .form-group
                label(for="lyrics")
                    | Lyrics
                textarea#lyrics.form-control.textarea-tinymce(name="lyrics" rows="4" placeholder="Lời bài hát...") #{song.lyrics}

            .row
                .col-md-6
                    .form-group
                        label(for="avatar")
                            | Ảnh
                        .upload-box.border.rounded.p-3
                            p.mb-2
                                strong Chọn ảnh
                            input#avatar.form-control-file(type="file" name="avatar" accept="image/*" upload-image-input)  
                            img#previewImage(
                                src=song.avatar ? song.avatar : ""
                                width="200"
                                class="mt-3 rounded border"
                                style=song.avatar ? "" : "display:none"
                            )                          
                            small.text-muted
                                | JPG, PNG tối đa 5MB

                .col-md-6
                    .form-group
                        label(for="audio")
                            | File bài hát
                        .upload-box.border.rounded.p-3
                            p.mb-2
                                strong Chọn file bài hát
                            input#audio.form-control-file(type="file" name="audio" accept="audio/*")
                            if(song.audio)
                                audio.mt-3(controls style="width:100%;")
                                    source(src=song.audio)
                            small.text-muted
                                | Tối đa 50MB