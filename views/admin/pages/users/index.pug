extends ../../layouts/default.pug

block main 
    h1.mb-4 #{pageTitle}

    .card.mb-3 
        .card-header Danh sách chủ đề
        .card-body          
            table.table.table-hover
                thead 
                    tr 
                        th STT 
                        th Hình ảnh 
                        th Họ và tên
                        th Email
                        th Trạng thái 
                        th Hành động 
                tbody 
                    if(users.length > 0)
                        each item, index in users 
                            tr 
                                td #{index+1} 
                                td 
                                    if item.avatar
                                        img(src=item.avatar, alt=item.fullname width="100px" height="auto")
                                    else
                                        img(src="", alt=item.fullname width="100px" height="auto")
                                td #{item.fullname} 
                                td #{item.email}
                                td
                                    if(item.status === "active")
                                        a.status-badge.active(href="javascript:;") Hoạt động 
                                    else 
                                        a.status-badge.inactive(href="javascript:;") Dừng hoạt động 
                                td 
                                    button.btn.btn-danger.btn-sm(button-delete data-id=item.id)
                                        <i class="fa-solid fa-trash"></i>
                    else 
                        tr 
                            td Không có dữ liệu
        //- form(action="", method="POST" id="form-change-status" data-path=`${prefixAdmin}/products/change-status`) 
        form(action="", method="POST" id="form-delete-item" data-path=`/${prefixAdmin}/users/delete`)
