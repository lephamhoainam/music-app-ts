extends ../../layouts/default.pug

block main 
    .content-wrapper
        form.song-form(action=`/${prefixAdmin}/singers/create` method="POST" enctype="multipart/form-data")
            .page-header.d-flex.justify-content-between.align-items-start.mb-4
                .header-left
                    h1.mb-2 #{pageTitle}

                .header-actions
                    button.btn.btn-outline-secondary.mr-2(type="button" onclick="window.location.href='/admin/singers'")
                        | Hủy
                    button.btn.btn-primary(type="submit")
                        | Lưu ca sĩ

            .row
                .col-md-8
                    .form-group
                        label(for="fullname")
                            | Tên ca sĩ
                        input#fullname.form-control(type="text" name="fullname" placeholder="Nhập tên ca sĩ..." required)

                .col-md-4
                    .form-group
                        label(for="status")
                            | Trạng thái
                        select#status.form-control(name="status")
                            option(value="active")
                                | Hoạt động (Mặc định)
                            option(value="inactive")
                                | Dừng hoạt động 

            .row
                .col-md-12
                    .form-group
                        label(for="avatar")
                            | Ảnh
                        .upload-box.border.rounded.p-3
                            p.mb-2
                                strong Chọn ảnh
                            input#avatar.form-control-file(type="file" name="avatar" accept="image/*" upload-image-input)                           
                            small.text-muted
                                | JPG, PNG tối đa 5MB