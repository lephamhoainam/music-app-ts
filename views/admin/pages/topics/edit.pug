extends ../../layouts/default.pug

block main 
    .content-wrapper
        form.song-form(action=`/${prefixAdmin}/topics/edit/${topic._id}?_method=PATCH` method="POST" enctype="multipart/form-data")
            .page-header.d-flex.justify-content-between.align-items-start.mb-4
                .header-left
                    h1.mb-2 #{pageTitle}

                .header-actions
                    button.btn.btn-outline-secondary.mr-2(type="button" onclick="window.location.href='/admin/topics'")
                        | Hủy
                    button.btn.btn-primary(type="submit")
                        | Lưu chủ đề

            .row
                .col-md-8
                    .form-group
                        label(for="title")
                            | Tên chủ đề
                        input#title.form-control(type="text" name="title" value=topic.title required)

                .col-md-4
                    .form-group
                        label(for="status")
                            | Trạng thái
                        select#status.form-control(name="status" value=topic.status)
                            option(value="active" selected=topic.status === "active")
                                | Hoạt động (Mặc định) 
                            option(value="inactive" selected=topic.status === "inactive")
                                | Dừng hoạt động 

            .form-group
                label(for="description")
                    | Mô tả
                textarea#description.form-control.textarea-tinymce(name="description" rows="4") #{topic.description}

            //- .row
            //-     .col-md-12
            //-         .form-group
            //-             label(for="avatar")
            //-                 | Ảnh
            //-             .upload-box.border.rounded.p-3
            //-                 p.mb-2
            //-                     strong Chọn ảnh
            //-                 input#avatar.form-control-file(type="file" name="avatar" accept="image/*" upload-image-input)  
            //-                 img#previewImage(src=topic.avatar, alt=topic.title, width="200", class="mt-3 rounded border")                         
            //-                 small.text-muted
            //-                     | JPG, PNG tối đa 5MB

            .row
                .col-md-12
                    .form-group
                        label(for="avatar")
                            | Ảnh

                        .upload-box.border.rounded.p-3
                            p.mb-2
                                strong Chọn ảnh

                            input#avatar.form-control-file(
                                type="file"
                                name="avatar"
                                accept="image/*"
                            )

                            if topic.avatar
                                img#previewImage(
                                    src=topic.avatar,
                                    alt=topic.title,
                                    width="200",
                                    class="mt-3 rounded border"
                                )

                            small.text-muted
                                | JPG, PNG tối đa 5MB