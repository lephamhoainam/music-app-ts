extends ../../layouts/default.pug

include ../../mixins/box-head.pug

block main 
    .container.my-3 
        .row 
            .col-12 
                +box-head(pageTitle)

        .card.mb-3
            .card-header Danh sách bài hát tìm kiếm
            .card-body
                table(class="table table-hover table-sm" checkbox-multi) 
                    thead 
                        tr  
                            th 
                                input(type="checkbox" name="checkall")
                            th STT  
                            th Ảnh 
                            th Tên bài hát
                            th Nghệ sĩ
                            th 
                                <i class="fa-regular fa-clock"></i>
                    tbody 
                        each item, index in songs
                            tr.table-row 
                                td 
                                    input(type="checkbox" name="id" value = item.id)
                                td #{index + 1}
                                td
                                    img(src=item._doc.avatar, alt=item._doc.title width="50px" height="50px")
                                td 
                                    a(href=`/songs/detail/${item._doc.slug}`)  #{item._doc.title}
                                td #{item.infoSinger.fullname}
                                td 