extends ../../layouts/default.pug

include ../../mixins/box-head.pug

block main 
    .singer-detail 
        .container.my-3 
            .row 
                .col-12 
                    .inner-title #{song.title}  

                    .inner-actions
                        div.inner-action.inner-time 
                            <i class="fa-regular fa-clock"></i> 20/10/2026
                        div.inner-action.inner-singer
                            <i class="fa-solid fa-microphone"></i> #{singer.fullname}
                        div.inner-action.inner-topic
                            <i class="fa-solid fa-music"></i> #{topic.title}
                        div.inner-action.inner-listen
                            <i class="fa-solid fa-headphones"></i> #{song.listen} lượt nghe
                        div.inner-action.inner-like(id-song=song.id)
                            i(class="fa-regular fa-thumbs-up" data-number-like=song.like) 
                            span #{song.like}
                        div.inner-action.inner-heart(button-favorite=song.id)
                            if(song.isFavoriteSong)
                                <i class="fa-solid fa-heart"></i> Thêm vào yêu thích    
                            else
                                <i class="fa-regular fa-heart"></i> Thêm vào yêu thích
                    
                    .inner-play 
                        .inner-avatar 
                            img(src=song.avatar, alt="Thumbnail bài hát", srcset="")
                        .inner-audio 
                            div#aplayer(data-song=song data-singer=singer)

                    .inner-desc 
                        .inner-label Mô tả 
                        .inner-text 
                            | #{song.description} 
                     
                    .inner-desc 
                        .inner-label Lời bài hát  
                        .inner-text 
                            | #{song.lyrics} 
                    