extends ../../layouts/default.pug

block main 
    .container
        .content-wrapper
            form.song-form(action=`/user/info` method="POST" enctype="multipart/form-data")
                .page-header.d-flex.justify-content-between.align-items-start.mb-4
                    .header-left
                        h1.mb-2 #{pageTitle}

                    .header-actions
                        button.btn.btn-outline-secondary.mr-2(type="button" onclick="window.location.href='/user/info'")
                            | Hủy
                        button.btn.btn-primary(type="submit")
                            | Cập nhật tài khoản

                .row
                    .col-md-12
                        .form-group
                            label(for="fullname")
                                | Họ và tên
                            input#fullname.form-control(
                                type="text" name="fullname" value=user.fullname required
                            )
            
                .row
                    .col-md-12
                        .form-group
                            label(for="email")
                                | Email
                            input#email.form-control(
                                type="email" name="email" value=user.email readonly
                            )
                    
                .row
                    .col-md-6
                        .form-group
                            label(for="password")
                                | Mật khẩu
                            input#password.form-control(
                                type="password" name="password" 
                                placeholder="Không cập nhật mật khẩu thì để trống"
                            )
                    .col-md-6
                        .form-group
                            label(for="phone")
                                | Số điện thoại
                            input#phone.form-control(
                                type="phone" name="phone" value=user.phone
                                placeholder="Không cập nhật số điện thoại thì để trống"
                            )

                .row 
                    .col-md-12
                        .form-group
                            label(for="avatar")
                                | Ảnh
                            .upload-box.border.rounded.p-3
                                p.mb-2
                                    strong Chọn ảnh
                                input#avatar.form-control-file(type="file" name="avatar" accept="image/*" upload-image-input)  
                                img#previewImage(
                                    src=user.avatar ? user.avatar : ""
                                    width="200"
                                    class="mt-3 rounded border"
                                    style=user.avatar ? "" : "display:none"
                                )                          
                                small.text-muted
                                    | JPG, PNG tối đa 5MB, không cập nhật thì để trống