header.header 
    .container 
        .row.align-items-center 
            .col-2
                .inner-logo 
                    a(href="/")
                        img(src="/images/logoMusicApp.png", alt="Logo music app", srcset="")

            .col-4
                .box-search 
                    form(action="/search/result", method="get") 
                        div.form-group.d-flex.mb-0 
                            input.form-control(type="text" placeholder="Nhập từ khóa..." name="keyword" value=keyword)
                            button.btn.btn-primary(type="submit") 
                                <i class="fa-solid fa-magnifying-glass"></i>
                    .inner-suggest 
                        .inner-list
                            //- a.inner-item(href="http://")
                            //-     .inner-image 
                            //-         img(src="", alt="", srcset="") 
                            //-     .inner-info 
                            //-         .inner-title
                            //-         .inner-singer 
            
            .col-6
                .inner-menu 
                    ul 
                        li 
                            a(href="/") Trang chủ
                        li 
                            a(href="/topics") Chủ đề
                        li 
                            a(href="/favorite-songs") Yêu thích
                        if(user)
                            li
                                a(href="/user/info") #{user.fullname}
                            li
                                a(href="/user/logout") Đăng xuất
                        else 
                            li
                                a(href="/user/login") Đăng Nhập
                            li
                                a(href="/user/register") Đăng ký